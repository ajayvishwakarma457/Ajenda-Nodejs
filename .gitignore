# Node.js
# =========================

# Dependency directories
node_modules/
jspm_packages/ # JSpM packages
bower_components/ # Bower packages (if used)

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Runtime data
.eslintcache
.stylelintcache
*.tgz # npm pack created tarballs

# Temporary files and directories
tmp/
temp/
.DS_Store # macOS specific
.idea/ # WebStorm/IntelliJ IDEA
.vscode/ # VS Code specific (if you don't want to share launch configs, etc.)
*.sublime-project # Sublime Text projects
*.sublime-workspace # Sublime Text workspaces

# Environment variables
.env
.env.development
.env.test
.env.production
.env.*.local
.env.local # for create-react-app style local env files

# Build artifacts
dist/
build/
coverage/ # Test coverage reports
out/

# Compiled files
*.js.map # Source maps
*.d.ts # TypeScript declaration files (if not intended to be committed)
*.tsbuildinfo # TypeScript build info

# Test and coverage
test/
*.spec.js
*.test.js
*.snap # Jest snapshot files

# Node-gyp build files
build/
.node_rewrite_trace/

# Other common ignored files
.nyc_output/
.npm/
.yarn/
!.yarn/patches # keep yarn patches if used
!.yarn/releases
!.yarn/plugins
.npmrc # npm config file (potentially sensitive)
.yarnrc # yarn config file (potentially sensitive)

# OS generated files
.DS_Store
.Trashes
Thumbs.db # Windows
ehthumbs.db # Windows
Desktop.ini # Windows

# Docker
Dockerfile.local
.dockerignore # If you want to handle specific Docker ignore rules here

# Editor specific
*~ # Emacs/Vim temporary files
# You might want to include other editor specific files if you know them.